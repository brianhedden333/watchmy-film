# Copy to server/.env and fill in. Never commit .env.
NODE_ENV=development
PORT=5050
# Public address of the site (no trailing slash). Dev: the Vite server.
APP_URL=http://localhost:5173
DB_PATH=data/watchmyfilm.db
UPLOAD_DIR=uploads

# Stripe (FTS account). Use sk_test_ keys until launch.
STRIPE_SECRET_KEY=sk_test_...
# Publishable key of the same account, for the embedded Stripe Connect onboarding. Not secret. Without it,
# "Connect Stripe" is off.
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=whsec_...
SETUP_FEE_CENTS=9900
# $0 to start by default (setup cost recovered with SETUP_SURCHARGE_CENTS per sale). Set SETUP_UPFRONT=1 to require paying the setup fee before review.
SETUP_UPFRONT=
SETUP_SURCHARGE_CENTS=100
# Payment method configuration for the setup fee (Stripe dashboard > Settings > Payment methods; cards only): pmc_...
STRIPE_PAYMENT_METHOD_CONFIG=

# SendGrid. Leave empty in dev: sign-in links are printed to the server log instead.
SENDGRID_API_KEY=
FROM_EMAIL=hello@watchmyfilm.online
FROM_NAME=watchmyfilm

ADMIN_EMAILS=brian@brianhedden.com
NOTIFY_EMAIL=brian@brianhedden.com

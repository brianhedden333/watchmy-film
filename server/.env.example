# Copy to server/.env and fill in. Never commit .env.
NODE_ENV=development
PORT=5050
# Public address of the site (no trailing slash). Dev: the Vite server.
APP_URL=http://localhost:5173
DB_PATH=data/watchmyfilm.db
UPLOAD_DIR=uploads

# Stripe (FTS account). Use sk_test_ keys until launch.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=whsec_...
SETUP_FEE_CENTS=9900

# SendGrid. Leave empty in dev: sign-in links are printed to the server log instead.
SENDGRID_API_KEY=
FROM_EMAIL=hello@watchmyfilm.online
FROM_NAME=watchmyfilm.online

ADMIN_EMAILS=brian@brianhedden.com
NOTIFY_EMAIL=brian@brianhedden.com
